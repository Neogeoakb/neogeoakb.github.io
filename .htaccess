RewriteEngine on
Options -Indexes
RewriteCond %{http_host} ^www\.akb\.soy\fercho[nc]
RewriteRule ^(.*)$ http://fercho.akb.soy/$1 [r=301,nc]

RewriteCond %{HTTPS} !=on                                                          
RewriteRule ^/?(.*) https://%{SERVER_NAME}/$1 [R,L]

#ErrorDocument 404 /404.html
